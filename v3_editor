    # --- Scanner Auto-Discovery Logic ---
    def auto_scan_state(self):
        input_path = self.file_path.get()
        state_id = self.state_id.get().strip()

        if not input_path or not os.path.exists(input_path):
            messagebox.showerror("Error", "Please select a valid save file before scanning.")
            return
        if not state_id:
            messagebox.showerror("Error", "Please enter a State ID to scan.")
            return

        self.btn_scan.config(text="Scanning file... Please wait", state="disabled")
        self.root.update_idletasks()

        # Dictionary to accumulate demographic sizing to handle sorting operations
        culture_population_map = {}
        found_religions = set()

        pop_start_re = re.compile(r"^\s*\d+=\s*\{")
        in_pop_block = False
        bracket_depth = 0
        pop_lines = []

        try:
            with open(input_path, "rb") as f_in:
                for raw_line in f_in:
                    line = raw_line.decode("utf-8", errors="ignore")

                    if not in_pop_block:
                        if pop_start_re.match(line):
                            in_pop_block = True
                            bracket_depth = 1
                            pop_lines = [line]
                    else:
                        pop_lines.append(line)
                        bracket_depth += line.count("{")
                        bracket_depth -= line.count("}")

                        if bracket_depth == 0:
                            in_pop_block = False
                            block_text = "".join(pop_lines)
                            pop_lines = []

                            if "location=" in block_text and "type=" in block_text:
                                loc_match = re.search(r"^\s*location=(\d+)", block_text, re.MULTILINE)
                                if loc_match and loc_match.group(1) == state_id:

                                    # Calculate pop block sizing parameters
                                    block_pop = 0
                                    wf_match = re.search(r"^\s*workforce=(\d+)", block_text, re.MULTILINE)
                                    dep_match = re.search(r"^\s*dependents=(\d+)", block_text, re.MULTILINE)

                                    if wf_match:
                                        block_pop += int(wf_match.group(1))
                                    if dep_match:
                                        block_pop += int(dep_match.group(1))

                                    # Harvest culture
                                    cult_match = re.search(r"^\s*culture=(\w+)", block_text, re.MULTILINE)
                                    if cult_match:
                                        cult_id = cult_match.group(1)
                                        culture_population_map[cult_id] = culture_population_map.get(cult_id,
                                                                                                     0) + block_pop

                                    # Harvest religion
                                    rel_match = re.search(r"^\s*religion=(\w+)", block_text, re.MULTILINE)
                                    if rel_match:
                                        found_religions.add(rel_match.group(1))

            self.clear_all_rows()

            # Sort items by structural aggregate descending order
            sorted_cultures = [c for c, _ in
                               sorted(culture_population_map.items(), key=lambda item: item[1], reverse=True)]

            if sorted_cultures:
                for cult in sorted_cultures:
                    self.add_culture_row(initial_target=cult)
            if found_religions:
                for rel in sorted(found_religions):
                    if rel in self.religion_list:
                        self.add_religion_row(initial_target=rel)

            messagebox.showinfo("Scan Complete",
                                f"Successfully found {len(sorted_cultures)} culture(s) and {len(found_religions)} religion(s) in State {state_id}!")

        except Exception as e:
            messagebox.showerror("Error During Scan", f"Failed to read demographic blocks: {str(e)}")
        finally:
            self.btn_scan.config(text="🔍 Scan State Demographics", state="normal")

