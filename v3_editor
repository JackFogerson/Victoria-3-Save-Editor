with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "cultures.json"), encoding="utf-8") as culture_file:
    CULTURE_NAMES = json.load(culture_file)


def culture_label(culture_id):
    return f"{culture_id} ({CULTURE_NAMES.get(culture_id) or 'pending'})"


def culture_id_from_input(value):
    value = value.strip()
    labeled = re.fullmatch(r"(\w+) \([^\n]*\)", value)
    if labeled:
        return labeled.group(1)
    for culture_id, name in CULTURE_NAMES.items():
        if name.casefold() == value.casefold():
            return culture_id
    if re.fullmatch(r"\w+", value):
        return value
    raise ValueError("Select a culture result or enter a culture ID.")


class CulturePicker(ttk.Combobox):
    """Editable ID/name search; dropdown labels never enter the save file."""

    def __init__(self, parent, variable):
        super().__init__(parent, textvariable=variable, width=21, state="normal")
        self.variable = variable
        self.configure(postcommand=self.refresh_results)
        self.bind("<KeyRelease>", self.refresh_results)
        self.bind("<<ComboboxSelected>>", self.format_selection)
        self.bind("<Return>", self.format_selection)
        self.refresh_results()
        self.suggestions = LiveSuggestions(self, variable, self.refresh_results)

    def refresh_results(self, event=None):
        query = self.variable.get().strip().casefold()
        results = [culture_label(cid) for cid, name in CULTURE_NAMES.items()
                   if query in cid.casefold() or query in name.casefold()
                   or query == culture_label(cid).casefold()]
        if query.isdecimal() and query not in CULTURE_NAMES:
            results.insert(0, culture_label(query))
        self.configure(values=results)

    def format_selection(self, event=None):
        if not self.variable.get().strip():
            return
        try:
            self.variable.set(culture_label(culture_id_from_input(self.variable.get())))
        except ValueError:
            pass
        self.refresh_results()


